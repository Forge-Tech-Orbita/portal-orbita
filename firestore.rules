rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validIdentity(data) {
      return data.instituicaoId in ['inst-demo', 'inst-horizonte']
        && data.matricula is string
        && data.matricula.matches('^[0-9]{1,20}$')
        && request.auth.token.email ==
          data.instituicaoId + '.' + data.matricula + '@auth.orbita.example';
    }
    match /students/{uid} {
      allow get: if owner(uid) && validIdentity(resource.data);
      allow update: if owner(uid) && validIdentity(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cursoId'])
        && resource.data.cursoId == null
        && request.resource.data.cursoId is string
        && (
          (resource.data.instituicaoId == 'inst-demo'
            && request.resource.data.cursoId in ['si', 'adm'])
          || (resource.data.instituicaoId == 'inst-horizonte'
            && request.resource.data.cursoId == 'si')
        )
        && get(/databases/$(database)/documents/institutions/$(resource.data.instituicaoId)/courses/$(request.resource.data.cursoId)).data.ativo == true;
      allow update: if owner(uid) && validIdentity(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['telefone', 'emailPessoal', 'cep', 'endereco'])
        && request.resource.data.get('telefone', '') is string
        && request.resource.data.get('emailPessoal', '') is string
        && request.resource.data.get('cep', '') is string
        && request.resource.data.get('endereco', '') is string
        && request.resource.data.get('telefone', '').size() <= 20
        && request.resource.data.get('emailPessoal', '').size() <= 254
        && request.resource.data.get('cep', '').size() <= 9
        && request.resource.data.get('endereco', '').size() <= 200;
      match /grades/{gradeId} {
        // Preservar o get existente das contas A/B, inclusive sem perfil novo.
        allow get: if owner(uid);
        allow list: if owner(uid)
          && validIdentity(get(/databases/$(database)/documents/students/$(uid)).data)
          && get(/databases/$(database)/documents/students/$(uid)).data.cursoId != null
          && resource.data.semestreLetivo ==
            get(/databases/$(database)/documents/students/$(uid)).data.semestreLetivo
          && resource.data.cursoId ==
            get(/databases/$(database)/documents/students/$(uid)).data.cursoId;
      }
    }
    match /institutions/{institutionId}/courses/{courseId} {
      allow read: if request.auth != null
        && validIdentity(get(/databases/$(database)/documents/students/$(request.auth.uid)).data)
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.instituicaoId == institutionId;
    }
  }
}
